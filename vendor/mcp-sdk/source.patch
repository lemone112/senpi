@@ -0,0 +1,65 @@
+import type { JSONRPCMessage } from '@modelcontextprotocol/core-internal';
+
+const MAX_MESSAGES = 128;
+const MAX_BYTES = 1024 * 1024;
+
+/** Bounded listen egress on a shared stdio wire, with exactly one send in flight. */
+export function createListenWriter(send: (message: JSONRPCMessage) => Promise<void>, onFailure: (error: Error) => void) {
+    type Entry = { serialized: string; bytes: number; isCurrent?: () => boolean; resolve: () => void; reject: (error: Error) => void };
+    const encoder = new TextEncoder();
+    const pending: Entry[] = [];
+    let bytes = 0;
+    let pumping = false;
+    let stopped: Error | undefined;
+    const close = (error = new Error('Listen writer closed')) => {
+        if (stopped !== undefined) return;
+        stopped = error;
+        for (const entry of pending.splice(0)) entry.reject(error);
+        bytes = 0;
+    };
+    const pump = async () => {
+        if (pumping || stopped !== undefined) return;
+        pumping = true;
+        try {
+            while (pending.length > 0 && stopped === undefined) {
+                const entry = pending[0]!;
+                if (entry.isCurrent?.() !== false) await send(JSON.parse(entry.serialized) as JSONRPCMessage);
+                if (stopped !== undefined) break;
+                pending.shift();
+                bytes -= entry.bytes;
+                entry.resolve();
+            }
+        } catch (error_) {
+            if (stopped === undefined) {
+                const error = error_ instanceof Error ? error_ : new Error(String(error_));
+                close(error);
+                onFailure(error);
+            }
+        } finally {
+            pumping = false;
+        }
+    };
+    return {
+        close,
+        get busy() {
+            return pending.length > 0;
+        },
+        send(message: JSONRPCMessage, isCurrent?: () => boolean): Promise<void> {
+            if (stopped !== undefined) return Promise.reject(stopped);
+            const serialized = JSON.stringify(message);
+            const size = encoder.encode(serialized).byteLength + 1;
+            if (pending.length >= MAX_MESSAGES || bytes + size > MAX_BYTES) {
+                const error = new Error('Subscription output buffer exceeded');
+                close(error);
+                onFailure(error);
+                return Promise.reject(error);
+            }
+            return new Promise<void>((resolve, reject) => {
+                // Retain the measured wire value, not mutable source objects.
+                pending.push({ serialized, bytes: size, isCurrent, resolve, reject });
+                bytes += size;
+                void pump();
+            });
+        }
+    };
+}
