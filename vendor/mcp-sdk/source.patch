+    onFailure: () => void;
+    onFinish: () => void;
+    onerror?: (error: Error) => void;
+}) {
+    const lifetime = new AbortController();
+    let active = false;
+    let finishing = false;
+    let pendingBytes = 0;
+    let pending: Array<{ extension: ListenExtension; event: ExtensionServerEvent }> = [];
+    let honored: HonoredListen | undefined;
+    const opened: OpenedListenExtension[] = [];
+    const acceptedFilters = new Map<ListenExtension, Readonly<Record<string, unknown>> | undefined>();
+    let rejectClosed!: (reason: Error) => void;
+    const closed = new Promise<never>((_, reject) => {
+        rejectClosed = reject;
+    });
+    const report = (error: unknown) => {
+        try {
+            options.onerror?.(error instanceof Error ? error : new Error(String(error)));
+        } catch {
+            /* Reporting must not interrupt subscription cleanup. */
+        }
+    };
+    const dispose = (resource: OpenedListenExtension) => {
+        try {
+            void Promise.resolve(resource.dispose?.()).catch(report);
+        } catch (error) {
+            report(error);
+        }
+    };
+    const close = () => {
+        if (lifetime.signal.aborted) return;
+        lifetime.abort();
+        pending = [];
+        pendingBytes = 0;
+        for (const resource of opened.splice(0)) dispose(resource);
+        rejectClosed(new Error('Subscription closed during setup'));
+    };
+    const fail = (error: unknown) => {
+        report(error);
+        close();
+        options.onFailure();
+    };
+    const deliver = (extension: ListenExtension, event: ExtensionServerEvent) => {
+        if (lifetime.signal.aborted || !extension.methods.includes(event.method)) return;
+        const accepted = honored?.extensions.find(entry => entry.extension === extension);
+        if (accepted === undefined) return;
+        try {
+            if (extension.accepts(accepted.honored, event)) options.onEvent(event);
+        } catch (error) {
+            fail(error);
+        }
+    };
+    const publish = (extension: ListenExtension, event: ExtensionServerEvent) => {
+        if (lifetime.signal.aborted || finishing || !extension.methods.includes(event.method)) return;
+        if (active) {
+            deliver(extension, event);
+            return;
+        }
+        try {
+            const serialized = JSON.stringify(event);
+            const bytes = encoder.encode(serialized).byteLength;
+            if (pending.length >= MAX_PENDING_EVENTS || pendingBytes + bytes > MAX_PENDING_BYTES) {
+                fail(new Error('Subscription setup notification buffer exceeded'));
+                return;
+            }
+            pending.push({ extension, event: JSON.parse(serialized) as ExtensionServerEvent });
+            pendingBytes += bytes;
+        } catch (error) {
+            fail(error);
+        }
+    };
+    const setup = Promise.all(
+        options.extensions.map(async extension => {
+            if (extension.open === undefined) return;
+            const resource = await extension.open(options.requested, options.capabilities, {
+                request: options.message,
+                ...(options.requestInfo !== undefined && { requestInfo: options.requestInfo }),
+                ...(options.authInfo !== undefined && { authInfo: options.authInfo }),
+                signal: lifetime.signal,
+                close: () => {
+                    if (lifetime.signal.aborted) return;
+                    close();
+                    options.onFailure();
+                },
+                finish: () => {
+                    if (lifetime.signal.aborted || finishing) return;
+                    finishing = true;
+                    if (active) options.onFinish();
+                },
+                publish: event => publish(extension, event)
+            });
+            if (resource !== undefined) {
+                if (lifetime.signal.aborted) dispose(resource);
+                else opened.push(resource);
+            }
+            // Retain the original extension, including its prototype and method
+            // receiver. A copied instance can lose open() and become broadcast.
+            acceptedFilters.set(extension, resource?.notifications);
+        })
+    ).then(() => {
+        if (lifetime.signal.aborted) throw new Error('Subscription closed during setup');
+        honored = honorListen(
+            options.filter,
+            options.requested,
+            options.capabilities,
+            options.extensions,
+            options.onerror,
+            acceptedFilters
+        );
+        return honored;
+    });
+    const ready = Promise.race([setup, closed]).catch(error => {
+        close();
+        throw error;
+    });
+    return {
+        ready,
+        close,
+        activate() {
+            if (active || lifetime.signal.aborted || honored === undefined) return;
+            active = true;
+            const queued = pending;
+            pending = [];
+            pendingBytes = 0;
+            for (const { extension, event } of queued) deliver(extension, event);
+            if (finishing && !lifetime.signal.aborted) options.onFinish();
+        }
+    };
+}
